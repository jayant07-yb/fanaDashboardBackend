# HTTP server - Redirect HTTP to HTTPS
server {
    listen 80;
    listen [::]:80;

    server_name internals.getfana.com;  # Your domain name

    # Redirect HTTP to HTTPS
    return 301 https://$host$request_uri;
}

# HTTPS server - Handle secure traffic
server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name internals.getfana.com;

    # SSL certificate and key
    ssl_certificate /etc/letsencrypt/live/internals.getfana.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/internals.getfana.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;


    # Static file settings
    location /static/ {
        alias /home/jayantanand/fanaSystemDash/fanaSystem/staticfiles/;  # Absolute path to the staticfiles directory
        expires 6M;  # Cache static files for 6 months
        access_log off;
        add_header Cache-Control "public, max-age=15552000";
    }

    # Proxy HTTP requests to Gunicorn
    location / {
        proxy_pass http://127.0.0.1:8000;  # Gunicorn backend (use HTTP here)
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Proxy WebSocket requests to Daphne
    location /ws/ {
        proxy_pass http://127.0.0.1:8001;  # Daphne backend (use HTTP here)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Custom 404 error page
    error_page 404 /404.html;
    location = /404.html {
        root /usr/share/nginx/html;
    }

    # Optional: Enable Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_proxied any;
    gzip_min_length 256;
}

